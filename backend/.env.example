# Copy to .env (or set in your host's dashboard). All optional.
PORT=8000
LOG_LEVEL=INFO
TETHER_ENV=development
# Comma-separated list of allowed browser origins; "*" allows all (fine for a demo).
CORS_ORIGINS=*
# When set, every POST/PUT/DELETE must send  X-API-Key: <value>  (the demo UI does not send one).
# TETHER_API_KEY=change-me
# Start with the red-team autopilot already running (good for a public demo).
TETHER_AUTOPILOT=0
TETHER_AUTOPILOT_INTERVAL=14
# TETHER_DB=/var/data/tether.db
